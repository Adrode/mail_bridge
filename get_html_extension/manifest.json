{
    "manifest_version": 3,
    "name": "Claim Mail Generator",
    "version": "1.0",
    "description": "Local claim mail generator",
    "permissions": ["tabs"],
    "action": {
        "default_popup": "popup.html"
    },
    "content_scripts": [
        {
            "matches": ["<all_urls>"],
            "js": ["content.js"]
        }
    ]
}